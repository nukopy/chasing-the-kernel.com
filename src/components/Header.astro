---
import SocialLinks from "./SocialLinks.astro";

const pathname = Astro.url.pathname;
const links = [
	{ href: "/about/", label: "About" },
	{ href: "/works/", label: "Works" },
	{ href: "/blog/", label: "Blog" },
	{ href: "/wiki/", label: "Wiki" },
	{ href: "/tags/", label: "Tags" },
];

const isCurrent = (href: string) => pathname.startsWith(href);
---

<header class="site-header">
	<div class="header-inner">
		<button
			class="menu-toggle"
			type="button"
			aria-label="メニューを開く"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</button>
		<a class="site-title" href="/">Chasing the Kernel</a>
		<nav class="desktop-nav" aria-label="メインナビゲーション">
			<ul>
				{
					links.map(({ href, label }) => (
						<li>
							<a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<dialog class="mobile-menu" id="mobile-menu">
		<div class="drawer">
			<div class="drawer-header">
				<a class="site-title" href="/">Chasing the Kernel</a>
				<button class="menu-close" type="button" aria-label="メニューを閉じる">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m6 6 12 12M18 6 6 18" />
					</svg>
				</button>
			</div>

			<nav class="mobile-nav" aria-label="モバイルナビゲーション">
				<ul>
					{
						links.map(({ href, label }) => (
							<li>
								<a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
									{label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="drawer-footer">
				<SocialLinks large />
			</div>
		</div>
	</dialog>
</header>

<script>
	const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
	const mobileMenu = document.querySelector<HTMLDialogElement>(".mobile-menu");
	const menuClose = document.querySelector<HTMLButtonElement>(".menu-close");
	const drawer = mobileMenu?.querySelector<HTMLElement>(".drawer");
	let closeTimer: number | undefined;
	let isClosing = false;

	const closeMobileMenu = (animate = true) => {
		if (!mobileMenu?.open || isClosing) return;

		if (!animate) {
			mobileMenu.classList.remove("is-open");
			mobileMenu.close();
			return;
		}

		isClosing = true;
		mobileMenu.classList.remove("is-open");

		const finishClose = () => {
			drawer?.removeEventListener("transitionend", handleTransitionEnd);
			if (closeTimer !== undefined) window.clearTimeout(closeTimer);
			if (mobileMenu.open) mobileMenu.close();
		};

		const handleTransitionEnd = (event: TransitionEvent) => {
			if (event.propertyName === "transform") finishClose();
		};

		drawer?.addEventListener("transitionend", handleTransitionEnd);
		closeTimer = window.setTimeout(finishClose, 260);
	};

	menuToggle?.addEventListener("click", () => {
		mobileMenu?.showModal();
		menuToggle.setAttribute("aria-expanded", "true");
		window.requestAnimationFrame(() => {
			window.requestAnimationFrame(() => mobileMenu?.classList.add("is-open"));
		});
	});

	menuClose?.addEventListener("click", () => closeMobileMenu());

	mobileMenu?.addEventListener("click", (event) => {
		if (event.target === mobileMenu) closeMobileMenu();
	});

	mobileMenu?.addEventListener("cancel", (event) => {
		event.preventDefault();
		closeMobileMenu();
	});

	mobileMenu?.addEventListener("close", () => {
		isClosing = false;
		mobileMenu.classList.remove("is-open");
		menuToggle?.setAttribute("aria-expanded", "false");
		menuToggle?.focus();
	});

	window.matchMedia("(max-width: 38rem)").addEventListener("change", (event) => {
		if (!event.matches) closeMobileMenu(false);
	});
</script>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(calc(100% - 2rem), var(--content-width));
		min-height: 4.5rem;
		margin-inline: auto;
		gap: 2rem;
	}

	.menu-toggle,
	.mobile-menu {
		display: none;
	}

	.site-title {
		color: var(--color-text);
		font-size: 1.15rem;
		font-weight: 800;
		text-decoration: none;
		white-space: nowrap;
	}

	.site-title:hover {
		color: var(--color-accent);
	}

	ul {
		display: flex;
		margin: 0;
		padding: 0;
		gap: 1.25rem;
		list-style: none;
	}

	nav a {
		color: var(--color-text);
		font-size: 1rem;
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current="page"] {
		color: var(--color-accent);
	}

	nav a[aria-current="page"] {
		font-weight: 700;
	}

	@media (max-width: 38rem) {
		.header-inner {
			justify-content: flex-start;
			gap: 1rem;
		}

		.menu-toggle,
		.menu-close {
			display: grid;
			width: 2.5rem;
			height: 2.5rem;
			padding: 0;
			border: 0px solid var(--color-border);
			background: transparent;
			color: var(--color-text);
			cursor: pointer;
			place-items: center;
		}

		.menu-toggle:hover,
		.menu-close:hover {
			color: var(--color-accent);
		}

		.menu-toggle svg,
		.menu-close svg {
			width: 1.35rem;
			height: 1.35rem;
			fill: none;
			stroke: currentColor;
			stroke-linecap: round;
			stroke-width: 2;
		}

		.desktop-nav {
			display: none;
		}

		.mobile-menu {
			position: fixed;
			inset: 0;
			display: none;
			width: 100vw;
			height: 100dvh;
			max-width: none;
			max-height: none;
			margin: 0;
			padding: 0;
			border: 0;
			background: transparent;
			color: var(--color-text);
			overflow: hidden;
		}

		.mobile-menu[open] {
			display: block;
		}

		.mobile-menu::backdrop {
			background-color: transparent;
			transition: background-color 220ms ease-in-out;
		}

		.mobile-menu.is-open::backdrop {
			background-color: rgb(0 0 0 / 35%);
		}

		.drawer {
			display: flex;
			width: min(82vw, 20rem);
			min-height: 100%;
			padding: 1rem;
			background: var(--color-surface);
			flex-direction: column;
			transform: translateX(-100%);
			transition: transform 220ms ease-in-out;
		}

		.mobile-menu.is-open .drawer {
			transform: translateX(0);
		}

		.drawer-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
		}

		.mobile-nav {
			margin-top: 2.5rem;
		}

		.mobile-nav ul {
			align-items: stretch;
			flex-direction: column;
			gap: 0;
		}

		.mobile-nav a {
			display: block;
			padding: 0.8rem 0.5rem;
			font-size: 1.2rem;
			font-weight: 700;
		}

		.drawer-footer {
			display: flex;
			justify-content: center;
			margin-top: auto;
			padding-block: 2rem 1rem;
		}
	}
</style>
