---
import BackLink from "./BackLink.astro";
import FormattedDateWithIcon from "./FormattedDateWithIcon.astro";
import { slugifyTag } from "../lib/content";

interface Props {
	title: string;
	date: Date;
	tags: string[];
	backHref: string;
	backLabel: string;
}

const { title, date, tags, backHref, backLabel } = Astro.props;
---

<header class="article-header">
	<BackLink href={backHref} label={backLabel} />
	<h1>{title}</h1>
	<div class="metadata">
		<FormattedDateWithIcon date={date} />
		{
			tags.length > 0 && (
				<ul aria-label="タグ">
					{tags.map((tag) => (
						<li>
							<a href={`/tags/${encodeURIComponent(slugifyTag(tag))}/`}>#{tag}</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</header>

<style>
	.article-header {
		padding-bottom: 1rem;
		/* border-bottom: 1px solid var(--color-border); */
	}

	h1 {
		margin-bottom: 0rem;
	}

	.metadata ul {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
	}

	.metadata {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 0.75rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.9rem;
	}

	.metadata ul {
		margin: 0;
		padding: 0;
		color: var(--color-accent);
		list-style: none;
	}
</style>
