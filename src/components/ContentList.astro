---
import { formatDate } from "../lib/date";
import type { SiteEntry } from "../lib/content";

interface Props {
	entries: SiteEntry[];
	showKind?: boolean;
	emptyMessage?: string;
}

const {
	entries,
	showKind = false,
	emptyMessage = "投稿はありません。",
} = Astro.props;
---

{
	entries.length > 0 ? (
		<ul class:list={["content-list", { "shows-kind": showKind }]}>
			{entries.map((entry) => (
				<li>
					<a class="entry-link" href={entry.href}>
						<span class="entry-header">
							<span class="entry-title">
								{showKind && <span class="kind">{entry.kind}</span>}
								<span>{entry.title}</span>
							</span>
							<time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>
						</span>
						{entry.tags.length > 0 && (
							<ul class="tags" aria-label="タグ">
								{entry.tags.map((tag) => <li>#{tag}</li>)}
							</ul>
						)}
					</a>
				</li>
			))}
		</ul>
	) : (
		<p class="empty-state">{emptyMessage}</p>
	)
}

<style>
	.content-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.content-list > li {
		border-bottom: 1px solid var(--color-border);
	}

	.content-list > li:first-child {
		border-top: 1px solid var(--color-border);
	}

	.entry-link {
		display: block;
		padding-block: 1.25rem;
		text-decoration: none;
		transition: background-color var(--transition-hover);
	}

	.entry-link:hover {
		background-color: var(--color-hover);
	}

	.entry-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		font-size: 1.05rem;
		font-weight: 700;
	}

	.entry-title {
		display: flex;
		align-items: baseline;
		color: var(--color-text);
		gap: 0.75rem;
	}

	.kind {
		display: inline-block;
		min-width: 3.5rem;
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--color-accent);
		color: var(--color-accent);
		font-size: 0.68rem;
		line-height: 1.4;
		text-align: center;
		text-transform: uppercase;
	}

	time {
		flex-shrink: 0;
		color: var(--color-text);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.78rem;
		font-weight: 400;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		margin: 0.5rem 0 0;
		padding: 0;
		color: var(--color-accent);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.78rem;
		gap: 0.5rem 1rem;
		list-style: none;
	}

	.shows-kind .tags {
		margin-left: 4.25rem;
	}

	.tags li {
		padding: 0;
		border: 0;
		font-weight: 400;
	}

	@media (max-width: 38rem) {
		.entry-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
		}

		.entry-title {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.4rem;
		}

		.shows-kind .tags {
			margin-left: 0;
		}
	}
</style>
