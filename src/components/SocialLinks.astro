---
interface Props {
	includeZenn?: boolean;
	large?: boolean;
}

const { includeZenn = false, large = false } = Astro.props;
---

<nav class:list={["social-links", { large }]} aria-label="ソーシャルリンク">
	<a
		href="https://github.com/nukopy"
		target="_blank"
		rel="me noreferrer"
		aria-label="GitHub"
	>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.88-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.12a9.3 9.3 0 0 1 2.5.35c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.8-4.58 5.05.36.32.68.95.68 1.92 0 1.38-.01 2.49-.01 2.83 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" />
		</svg>
	</a>
	<a
		href="https://x.com/nukopy_dev"
		target="_blank"
		rel="me noreferrer"
		aria-label="X"
	>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.74-8.85L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64Z" />
		</svg>
	</a>
	{
		includeZenn && (
			<a
				href="https://zenn.dev/pyteyon"
				target="_blank"
				rel="me noreferrer"
				aria-label="Zenn"
			>
				<span class="zenn-icon" aria-hidden="true" />
			</a>
		)
	}
</nav>

<style>
	.social-links {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	a {
		display: grid;
		place-items: center;
		color: var(--color-text);
	}

	a:hover {
		color: var(--color-accent);
	}

	svg,
	.zenn-icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	svg {
		fill: currentColor;
	}

	.zenn-icon {
		background: currentColor;
		-webkit-mask: url("/icons/zenn-black.png") center / contain no-repeat;
		mask: url("/icons/zenn-black.png") center / contain no-repeat;
	}

	.large :is(svg, .zenn-icon) {
		width: 1.75rem;
		height: 1.75rem;
	}
</style>
