---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
---

<BaseLayout title="About" description="Chasing the Kernel のプロフィール">
	<div class="container page">
		<header class="page-header">
			<h1>About</h1>
		</header>


		<p>I'm a software engineer.<br/>I love Go and Rust.</p>
		<SocialLinks includeZenn large />

	</div>
</BaseLayout>

<style>
	p {
		margin-top: 0.5rem;
		margin-bottom: 1rem;
	}

	.social-links {
		margin-top: 2rem;
	}
</style>
