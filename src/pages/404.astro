---
import BaseLayout from "../layouts/BaseLayout.astro";
import BackLink from "../components/BackLink.astro";
---

<BaseLayout title="404" description="ページが見つかりません">
	<div class="container page error-page">
		<h1>404</h1>
		<p>Page not found.</p>
		<BackLink href="/" label="Back to Home" />
	</div>
</BaseLayout>

<style>
	.error-page h1 {
		margin: 0;
	}

	.error-page p {
		margin-block: 0.75rem 0.75rem;
	}

	.error-page nav {
		display: flex;
		gap: 1.5rem;
	}

	.error-page a {
		font-weight: 700;
	}
</style>
