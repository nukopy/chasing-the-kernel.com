---
import { render, type CollectionEntry } from "astro:content";
import ArticleHeader from "../../components/ArticleHeader.astro";
import CodeBlockEnhancer from "../../components/CodeBlockEnhancer/index.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedWikiEntries } from "../../lib/content";

export async function getStaticPaths() {
	const entries = await getPublishedWikiEntries();

	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<"wiki">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<article class="container page">
		<ArticleHeader
			title={entry.data.title}
			date={entry.data.date}
			tags={entry.data.tags}
			backHref="/wiki/"
			backLabel="Back to Wiki"
		/>

		<div class="prose">
			<Content />
		</div>
	</article>
	<CodeBlockEnhancer />
</BaseLayout>
