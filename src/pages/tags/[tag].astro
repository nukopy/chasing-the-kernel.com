---
import ContentList from "../../components/ContentList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
	getPublishedSiteEntries,
	slugifyTag,
	type SiteEntry,
} from "../../lib/content";

export async function getStaticPaths() {
	const entries = await getPublishedSiteEntries();
	const tags = new Map<string, string>();

	for (const entry of entries) {
		for (const tag of entry.tags) {
			const slug = slugifyTag(tag);
			if (!tags.has(slug)) tags.set(slug, tag);
		}
	}

	return Array.from(tags.entries()).map(([slug, tag]) => ({
		params: { tag: slug },
		props: {
			tag,
			entries: entries.filter((entry) => entry.tags.includes(tag)),
		},
	}));
}

interface Props {
	tag: string;
	entries: SiteEntry[];
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`${tag} タグの Blog と Wiki`}>
	<div class="container page">
		<header class="page-header">
			<a class="back-link" href="/tags/">← Tags</a>
			<h1>#{tag}</h1>
		</header>

		<ContentList entries={entries} showKind />
	</div>
</BaseLayout>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
	}
</style>
